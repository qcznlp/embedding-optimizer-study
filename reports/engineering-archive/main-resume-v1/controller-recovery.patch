+def _validate_step_records(
+    ledger: dict[str, Any], steps: list[PipelineStep], repository: Path
+) -> None:
+    """Accept only the recorded, source-bound prefix of this serial plan."""
+    records = ledger.get("steps")
+    if not isinstance(records, list) or len(records) > len(steps):
+        raise RuntimeError("Invalid completion step history")
+    for index, record in enumerate(records, start=1):
+        step = steps[index - 1]
+        if (
+            not isinstance(record, dict)
+            or record.get("index") != index
+            or record.get("name") != step.name
+            or record.get("command") != list(step.command)
+            or type(record.get("complete")) is not bool
+            or not isinstance(record.get("attempts"), list)
+        ):
+            raise RuntimeError("Completion step history differs from the exact plan")
+        previous_attempt = 0
+        for attempt in record["attempts"]:
+            if (
+                not isinstance(attempt, dict)
+                or type(attempt.get("attempt")) is not int
+                or attempt["attempt"] <= previous_attempt
+            ):
+                raise RuntimeError("Invalid completion attempt history")
+            previous_attempt = attempt["attempt"]
+            log = attempt.get("log", {})
+            expected = f"{index:02d}-{step.name}.attempt-{previous_attempt}.log"
+            try:
+                path = (repository / log["path"]).resolve()
+                if (
+                    not path.is_relative_to(repository.resolve())
+                    or path.name != expected
+                    or _file_identity(path, repository) != log
+                ):
+                    raise RuntimeError("Completion attempt log identity changed")
+            except (OSError, KeyError, TypeError, ValueError) as error:
+                raise RuntimeError("Completion attempt log is missing or invalid") from error
+        attempts = record["attempts"]
+        success = bool(
+            attempts
+            and type(attempts[-1].get("return_code")) is int
+            and attempts[-1]["return_code"] == 0
+            and "execution_error" not in attempts[-1]
+        )
+        if record["complete"] != success or (not success and index != len(records)):
+            raise RuntimeError("Completion history has a false or out-of-order success")
 
 
